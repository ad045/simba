# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# docs build (mkdocs)
site/

# editor / agent tooling
.DS_Store
.vscode/
.claude/
graphify-out/

# The paper's run tree is local: paper/data and paper/output are symlinks into
# it (about 225 GB). The data bundle is built into paper/publication_data/ and
# published as a GitHub release asset, never committed.
paper/data
paper/output
paper/publication_data/
publication_data/
density_fix/
wandb/

# generated results never go into git; the tracked figures are the exception
*.npy
*.npz
*.csv
*.csv.gz
*.zip
*.png
*.jpg
*.pdf
!paper/figures/**/*.pdf
*.log
*.txt

# Agent instructions, not part of the release
CLAUDE.md

# Exceptions to the blanket rules above: the released data bundle and the
# documentation assets are part of the repository.
!data/**
!docs/assets/**
