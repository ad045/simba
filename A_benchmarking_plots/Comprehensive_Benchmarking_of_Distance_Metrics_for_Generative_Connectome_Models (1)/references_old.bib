@online{liu_2025_netneurotools,
  title = {Netneurotools: A Trainee-Oriented Approach to Network Neuroscience},
  shorttitle = {Netneurotools},
  author = {Liu, Zhen-Qi and Bazinet, Vincent and Hansen, Justine Y. and Milisav, Filip and Luppi, Andrea I. and Ceballos, Eric G. and Farahani, Asa and Suarez, Laura E. and Shafiei, Golia and Markello, Ross D. and Misic, Bratislav},
  date = {2025-09-13},
