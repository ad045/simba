@incollection{fornito_2016_chapterf,
  title = {Chapter 7 - {{Paths}}, {{Diffusion}}, and {{Navigation}}},
  booktitle = {Fundamentals of {{Brain Network Analysis}}},
  editor = {Fornito, Alex and Zalesky, Andrew and Bullmore, Edward T.},
  date = {2016-01-01},
  pages = {207--255},
  publisher = {Academic Press},
  location = {San Diego},
  doi = {10.1016/B978-0-12-407908-3.00007-8},
  url = {https://www.sciencedirect.com/science/article/pii/B9780124079083000078},
  urldate = {2025-06-04},
  abstract = {A key question for connectomics is how topological properties of brain graphs relate to the signaling and information processing functions of nervous systems. Three models of neural information flow are considered in the chapter: shortest path routing, diffusion, and navigation. These models are explained with intuitive metaphors. The efficiency with which information can be communicated under these models is quantified with various measures of network integration. Shortest path routing is the most commonly studied model, and is fundamental to the concept of the brain as a small-world network. Shortest path routing assumes that neurons communicate with well-defined destinations in mind, and that the shortest path to these destinations is known globally. These may be unrealistic assumptions in nervous systems, motivating the study of alternative models of neural information flow that does not mandate centralized, homunculus-like control. Diffusion processes imply that the flow of information is much like the flow of fluids in a network of pipes, which propagates simultaneously along multiple ‘fronts’, without being directed toward a single destination. Communicability is the simplest measure quantifying the efficiency with which information can be communicated under this model. Another model is navigation, where each node forwards information to its closest neighbour in physical distance to the desired destination. Navigation performs particularly well in spatially-embedded, scale-free networks like the brain. We discuss the pros and cons of all three models of neural information flow, and show how they have been applied in order to understand the organization of connectomes at various scales. This chapter also introduces readers to a random walker, the Laplacian matrix and the concept of a network morphospace.},
  isbn = {978-0-12-407908-3},
  keywords = {Characteristic path length,Communicability,Communication,Cycle,Diffusion,Efficiency,Geodesic,Hop count,Laplacian matrix,Mean first passage time,Navigation,Network morphospace,Path,Path transitivity,Random walker,Routing,Search information,Shortest path,Trail,Walk}
}

@incollection{fornito_2016_chapterg,
  title = {Chapter 8 - {{Motifs}}, {{Small Worlds}}, and {{Network Economy}}},
  booktitle = {Fundamentals of {{Brain Network Analysis}}},
  editor = {Fornito, Alex and Zalesky, Andrew and Bullmore, Edward T.},
  date = {2016-01-01},
  pages = {257--301},
  publisher = {Academic Press},
  location = {San Diego},
  doi = {10.1016/B978-0-12-407908-3.00008-X},
  url = {https://www.sciencedirect.com/science/article/pii/B978012407908300008X},
  urldate = {2025-06-04},
  abstract = {Motifs are subgraphs of a network that act as elemental building blocks for its topology. Motifs can be defined at the level of connected subgraphs of nodes, or at the level of an ordered sequence of edges comprising a path. Another popular measure for studying small subsets of nodes is the clustering coefficient, which counts the fraction of a node’s neighbors, which are also connected to each other. We consider how clustering relates to more general measures of structural equivalence, topological overlap, degeneracy and redundancy in networks, and how it is an essential component of the brain’s small-world organization. Small-world properties are thought to endow brain networks with many functional advantages, such as the simultaneous capacity for integrated and segregated function, which gives rise to high dynamical complexity. We close the chapter by examining the important role of wiring costs in driving network organization. Each connection in a brain network carries a cost in terms of the physical space, cellular material, and metabolic resources that it requires. Lying at the heart of the network economy is the effective management of finite metabolic and cellular resources, while supporting the adaptive topological properties that promote robust and adaptive performance. We consider simple methods for capturing the trade-off between cost and adaptive topology, before examining more sophisticated approaches adapted from other scientific disciplines, such as the analysis of Rentian scaling.},
  isbn = {978-0-12-407908-3},
  keywords = {Brain metabolism,Clustering,Complexity,Cost-efficiency,Degeneracy,Fractal,Motif,Mutual information,Network economy,Redundancy,Rentian scaling,Small world,Structural equivalence,Wiring cost}
}

@incollection{fornito_2016_chapterh,
  title = {Chapter 9 - {{Modularity}}},
  booktitle = {Fundamentals of {{Brain Network Analysis}}},
  editor = {Fornito, Alex and Zalesky, Andrew and Bullmore, Edward T.},
  date = {2016-01-01},
  pages = {303--354},
  publisher = {Academic Press},
  location = {San Diego},
  doi = {10.1016/B978-0-12-407908-3.00009-1},
  url = {https://www.sciencedirect.com/science/article/pii/B9780124079083000091},
  urldate = {2025-06-04},
  abstract = {The nodes of many real-world networks are often more strongly connected with some sets of nodes than with others, giving rise to densely linked communities of nodes called modules. These modules also contain submodules across several scales of topological resolution, resulting in a hierarchical modular organization. This chapter presents key methods for characterizing the modular structure of brain networks. We begin by discussing traditional hierarchical clustering approaches, before explaining methods based on betweenness centrality and the optimization of a quality function called the modularity index. We consider methods for characterizing the modular organization of populations of networks, for quantifying the overlap between two modular partitions, and for constructing a consensus partition from multiple decompositions. Statistical methods for comparing the modular structure of two or more networks are also considered. We overview the limitations of modularity maximization, consider alternatives, and introduce methods for studying overlapping modules. The chapter closes with a discussion on how dynamic modular structure can be studied in temporally evolving systems through the use of multilayer network models.},
  isbn = {978-0-12-407908-3},
  keywords = {Community structure,Dendrogram,Hierarchical clustering,Louvain algorithm,modularity,multilayer network,participation coefficient,partition overlap}
}

@incollection{fornito_2016_chapteri,
  title = {Chapter 10 - {{Null Models}}},
  booktitle = {Fundamentals of {{Brain Network Analysis}}},
  editor = {Fornito, Alex and Zalesky, Andrew and Bullmore, Edward T.},
  date = {2016-01-01},
  pages = {355--381},
  publisher = {Academic Press},
  location = {San Diego},
  doi = {10.1016/B978-0-12-407908-3.00010-8},
  url = {https://www.sciencedirect.com/science/article/pii/B9780124079083000108},
  urldate = {2025-06-04},
  abstract = {Null models are crucial in determining whether brain networks display certain features to a greater extent than expected by chance under a null hypothesis. The most common null model for a graph is constructed by rewiring its edges according to the Maslov-Sneppen rewiring algorithm. Rather than randomizing an existing network, null models can also be constructed by growing networks according to a generative mechanism. The classic Watts-Strogatz model generates small-world networks, while the Barabási-Albert model is based on a preferential attachment mechanism that produces scale-free degree distributions. Generative models that take into account the spatial embedding of a nervous system can accurately predict many spatial and topological features. One of the most accurate and simplest of these models is the so-called economical clustering model, which places a penalty on long distance connections, and encourages the formation of closed triangle motifs. Null models for correlation-based functional networks present particular challenges. Techniques for generating null models that preserve the intrinsic transitivity of these networks are described. This chapter also considers exponential random graph models, which are a versatile approach for sampling networks from a specified distribution, as well as generalizations of the Maslov-Sneppen rewiring algorithm that can be applied to weighted and signed graphs. Null models for testing hypotheses about functional connectivity dynamics are briefly covered.},
  isbn = {978-0-12-407908-3},
  keywords = {Generative model,Nonstationarity,Null model,Preferential attachment,Random graph,Small-world,Time series}
}

@incollection{fornito_2016_chapterj,
  title = {Chapter 11 - {{Statistical Connectomics}}},
  booktitle = {Fundamentals of {{Brain Network Analysis}}},
  editor = {Fornito, Alex and Zalesky, Andrew and Bullmore, Edward T.},
  date = {2016-01-01},
  pages = {383--419},
  publisher = {Academic Press},
  location = {San Diego},
  doi = {10.1016/B978-0-12-407908-3.00011-X},
  url = {https://www.sciencedirect.com/science/article/pii/B978012407908300011X},
  urldate = {2025-06-04},
  abstract = {This chapter considers two important topics in the statistical analysis of brain networks: thresholding and statistical hypothesis testing. Brain connectivity data are noisy, meaning that brain networks contain false positives (spurious connections) and false negatives (the absence of real connections). Applying a threshold to the adjacency matrix can suppress the contribution of spurious connections, and allows for the fixing of the connection density of the network. When analyzing groups of brain networks, thresholding can be performed to ensure a common connection density across all individuals, or with respect to an absolute edge weight threshold, it can eliminate all connections with weights less than the specified threshold. The pros and cons of these two global thresholding strategies are considered in detail. Local thresholding methods based on the minimum spanning tree, and the disparity filter, are also described. Unlike global thresholding, local methods can avoid network fragmentation. The second part of this chapter focuses on statistical hypothesis testing on the connectome. We consider statistical inference at the level of the connectome as a whole (global testing) as well as connectome-wide testing of a null hypothesis at every node and/or connection (mass univariate testing). While the latter approach enables finer localization of statistical effects, it presents a daunting multiple comparisons problem. Old and trusted generic methods as well as novel network-specific methods for dealing with the multiple comparisons problem are presented, including the false discovery rate, network-based statistic, and cutting-edge multivariate approaches. The appeal of multivariate approaches is that they allow inference at the level of individuals. This chapter also discusses how clinical differences in brain networks can be interpreted with respect to pathophysiological mechanisms. A non-technical introduction to permutation tests is provided.},
  isbn = {978-0-12-407908-3},
  keywords = {False discovery rate,Machine learning,Multiple comparisons,Multivariate,Network-based statistic,Statistical inference,Support vector machine},
  file = {/Users/adrian/Zotero/storage/K6XS9KRE/Fornito et al. - 2016 - Chapter 11 - Statistical Connectomics.pdf}
}

