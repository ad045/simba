@online{koutra_2013_deltacon,
  title = {{{DELTACON}}: {{A Principled Massive-Graph Similarity Function}}},
  shorttitle = {{{DELTACON}}},
  author = {Koutra, Danai and Vogelstein, Joshua T. and Faloutsos, Christos},
