@article{faskowitz_2023_connectomeb,
  title = {Connectome Topology of Mammalian Brains and Its Relationship to Taxonomy and Phylogeny},
  author = {Faskowitz, Joshua and Puxeddu, Maria Grazia and family=Heuvel, given=Martijn P., prefix=van den, useprefix=true and Mišić, Bratislav and Yovel, Yossi and Assaf, Yaniv and Betzel, Richard F. and Sporns, Olaf},
