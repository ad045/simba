@article{liu_2025_benchmarking,
  title = {Benchmarking Methods for Mapping Functional Connectivity in the Brain},
  author = {Liu, Zhen-Qi and Luppi, Andrea I. and Hansen, Justine Y. and Tian, Ye Ella and Zalesky, Andrew and Yeo, B. T. Thomas and Fulcher, Ben D. and Misic, Bratislav},
