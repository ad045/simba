  publisher = {Multidisciplinary Digital Publishing Institute},
  issn = {2072-666X},
  doi = {10.3390/mi13010030},
  urldate = {2022-11-19},
  abstract = {Acoustics have a wide range of uses, from noise-cancelling to ultrasonic imaging. There has been a surge in interest in developing acoustic-based approaches for biological and biomedical applications in the last decade. This review focused on the application of surface acoustic waves (SAW) based on interdigital transducers (IDT) for live-cell investigations, such as cell manipulation, cell separation, cell seeding, cell migration, cell characteristics, and cell behaviours. The approach is also known as acoustofluidic, because the SAW device is coupled with a microfluidic system that contains live cells. This article provides an overview of several forms of IDT of SAW devices on recently used cells. Conclusively, a brief viewpoint and overview of the future application of SAW techniques in live-cell investigations were presented.},
  copyright = {http://creativecommons.org/licenses/by/3.0/},
  langid = {english},
  keywords = {acoustofluidic,interdigital transducer (IDT),live cells,surface acoustic wave (SAW) technique},
  file = {/Users/adrian/Zotero/storage/Q3PW6MMM/Mazalan et al. - 2022 - Current Development in Interdigital Transducer (ID.pdf;/Users/adrian/Zotero/storage/JS42QZLB/30.html}
}

