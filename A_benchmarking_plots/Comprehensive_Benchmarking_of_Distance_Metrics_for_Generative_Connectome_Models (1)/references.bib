  year = 1978,
  month = jun,
  journal = {Sensory processes},
  volume = {2},
  number = {2},
  pages = {99--115},
  issn = {0363-3799},
  abstract = {Psychophysical thresholds for the detection of vibration on the thenar eminence were measured as a function of stimulus frequency. As has been found in earlier studies, the threshold functions had two separate branches: one relatively flat branch at low frequencies and a U-shaped branch at higher frequencies. When the rigid surround which is used to confine the stimulus to the region of the vibrator contactor was removed and vibration was allowed to spread freely over the surface of the skin, thresholds along the relatively flat segment of the curve increased while thresholds along the U-shaped segment decreased. The results were interpreted in terms of the duplex model of mechanoreception.},
  langid = {english},
  pmid = {715473}
}

