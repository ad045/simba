  author = {Gao, Zhongke and Dang, Weidong and Liu, Mingxu and Guo, Wei and Ma, Kai and Chen, Guanrong},
  year = 2021,
  month = nov,
  journal = {IEEE Transactions on Systems, Man, and Cybernetics: Systems},
  volume = {51},
  number = {11},
  pages = {7143--7151},
  issn = {2168-2232},
  doi = {10.1109/TSMC.2020.2964684},
  urldate = {2024-07-16},
  abstract = {Brain--computer interface (BCI) systems based on electroencephalography (EEG) signals have been extensively used in medical practice. To enhance the BCI performance, improving the classification accuracy of EEG signals is the key, which has always been the focus of research and development. In this article, a novel method integrating complex network and broad learning system (BLS) is proposed for visual evoked potential (VEP)-based BCI research. First, systematic VEP-based brain experiments are conducted for obtaining EEG signals, including steady-state VEP (SSVEP) and steady-state motion VEP (SSMVEP). Then, limited penetrable visibility graph (LPVG) and its degree sequence are employed to implement the preliminary feature extraction. All these features are finally fed into a BLS to study and classify the SSVEP and SSMVEP signals, respectively. The classification results show that our LPVG-based BLS can effectively classify VEP-based EEG signals, with average classification accuracy 96.22\% for SSVEP and 74.54\% for SSMVEP. These results are significantly better than other comparison methods as well as traditional CCA-based methods. All these open up new venues for studying EEG-based BCI systems via the fusion of network science and BLS.},
  keywords = {Bars,Broad learning system (BLS),Complex networks,Electroencephalography,electroencephalography (EEG) signals,Feature extraction,limited penetrable visibility graph (LPVG),Steady-state,steady-state motion VEP (SSMVEP),steady-state VEP (SSVEP),Time series analysis,Visualization},
  file = {/Users/adrian/Zotero/storage/JUIT8QF8/Gao et al. - 2021 - Classification of EEG Signals on VEP-Based BCI Sys.pdf;/Users/adrian/Zotero/storage/YJGJTTIW/8982166.html}
}

