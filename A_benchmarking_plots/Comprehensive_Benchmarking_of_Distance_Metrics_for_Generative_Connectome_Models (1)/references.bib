@article{fakhar_2024_downstream,
  title = {Downstream Network Transformations Dissociate Neural Activity from Causal Functional Contributions},
  author = {Fakhar, Kayson and Dixit, Shrey and Hadaeghi, Fatemeh and Kording, Konrad P. and Hilgetag, Claus C.},
  year = 2024,
  month = jan,
  journal = {Scientific Reports},
  volume = {14},
  number = {1},
  pages = {2103},
  issn = {2045-2322},
  doi = {10.1038/s41598-024-52423-7},
  urldate = {2025-05-28},
  abstract = {Abstract Neuroscientists rely on distributed spatio-temporal patterns of neural activity to understand how neural units contribute to cognitive functions and behavior. However, the extent to which neural activity reliably indicates a unit's causal contribution to the behavior is not well understood. To address this issue, we provide a systematic multi-site perturbation framework that captures time-varying causal contributions of elements to a collectively produced outcome. Applying our framework to intuitive toy examples and artificial neural networks revealed that recorded activity patterns of neural elements may not be generally informative of their causal contribution due to activity transformations within a network. Overall, our findings emphasize the limitations of inferring causal mechanisms from neural activities and offer a rigorous lesioning framework for elucidating causal neural contributions.},
  langid = {english},
  keywords = {Really important},
  file = {/Users/adrian/Zotero/storage/XQ2GI5F2/Fakhar et al. - 2024 - Downstream network transformations dissociate neural activity from causal functional contributions.pdf}
}

