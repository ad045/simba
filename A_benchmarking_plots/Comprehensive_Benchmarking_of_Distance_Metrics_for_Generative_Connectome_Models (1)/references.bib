  langid = {english},
  keywords = {Already in thesis,Computational neuroscience,Computational science,Computer science,Software,Solar physics},
  file = {/Users/adrian/Zotero/storage/QEMECZ7K/Harris et al. - 2020 - Array programming with NumPy.pdf}
