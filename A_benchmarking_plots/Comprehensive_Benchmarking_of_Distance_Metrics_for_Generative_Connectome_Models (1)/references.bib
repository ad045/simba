  title = {The {{Lifespan Human Connectome Project}} in {{Development}}: {{A}} Large-Scale Study of Brain Connectivity Development in 5--21 Year Olds},
  shorttitle = {The {{Lifespan Human Connectome Project}} in {{Development}}},
  author = {Somerville, Leah H. and Bookheimer, Susan Y. and Buckner, Randy L. and Burgess, Gregory C. and Curtiss, Sandra W. and Dapretto, Mirella and Stine Elam, Jennifer and Gaffrey, Michael S. and Harms, Michael P. and Hodge, Cynthia and Kandala, Sridhar and Kastman, Erik K. and Nichols, Thomas E. and Schlaggar, Bradley L. and Smith, Stephen M. and Thomas, Kathleen M. and Yacoub, Essa and Van Essen, David C. and Barch, Deanna M.},
  year = 2018,
  month = dec,
  journal = {NeuroImage},
  volume = {183},
  pages = {456--468},
  issn = {1053-8119},
  doi = {10.1016/j.neuroimage.2018.08.050},
  urldate = {2026-03-17},
  abstract = {Recent technological and analytical progress in brain imaging has enabled the examination of brain organization and connectivity at unprecedented levels of detail. The Human Connectome Project in Development (HCP-D) is exploiting these tools to chart developmental changes in brain connectivity. When complete, the HCP-D will comprise approximately \textasciitilde 1750 open access datasets from 1300 \th{} healthy human participants, ages 5--21 years, acquired at four sites across the USA. The participants are from diverse geographical, ethnic, and socioeconomic backgrounds. While most participants are tested once, others take part in a three-wave longitudinal component focused on the pubertal period (ages 9--17 years). Brain imaging sessions are acquired on a 3 T Siemens Prisma platform and include structural, functional (resting state and task-based), diffusion, and perfusion imaging, physiological monitoring, and a battery of cognitive tasks and self-reports. For minors, parents additionally complete a battery of instruments to characterize cognitive and emotional development, and environmental variables relevant to development. Participants provide biological samples of blood, saliva, and hair, enabling assays of pubertal hormones, health markers, and banked DNA samples. This paper outlines the overarching aims of the project, the approach taken to acquire maximally informative data while minimizing participant burden, preliminary analyses, and discussion of the intended uses and limitations of the dataset.},
  pmcid = {PMC6416053},
  pmid = {30142446},
  keywords = {Already in thesis},
  file = {/Users/adrian/Zotero/storage/V85KTNRB/Somerville et al. - 2018 - The Lifespan Human Connectome Project in Development A large-scale study of brain connectivity deve.pdf}
}

@inproceedings{soundarajan_2014_guide,
  title = {A {{Guide}} to {{Selecting}} a {{Network Similarity Method}}},
  booktitle = {Proceedings of the 2014 {{SIAM International Conference}} on {{Data Mining}}},
  author = {Soundarajan, Sucheta and {Eliassi-Rad}, Tina and Gallagher, Brian},
  year = 2014,
  month = apr,
  pages = {1037--1045},
  publisher = {{Society for Industrial and Applied Mathematics}},
  doi = {10.1137/1.9781611973440.118},
  urldate = {2026-01-23},
  abstract = {We consider the problem of determining how similar two networks (without known node-correspondences) are. This problem occurs frequently in real-world applications such as transfer learning and change detection. Many networksimilarity methods exist; and it is unclear how one should select from amongst them. We provide the first empirical study on the relationships between di↵erent networksimilarity methods. Specifically, we present (1) an approach for identifying groups of comparable network-similarity methods and (2) an approach for computing the consensus among a given set of network-similarity methods. We compare and contrast twenty network-similarity methods by applying our approaches to a variety of real datasets spanning multiple domains. Our experiments demonstrate that (1) di↵erent network-similarity methods are surprisingly well correlated, (2) some complex network-similarity methods can be closely approximated by a much simpler method, and (3) a few network similarity methods produce rankings that are very close to the consensus ranking.},
  isbn = {978-1-61197-344-0},
  langid = {english},
  file = {/Users/adrian/Zotero/storage/JGDUP4UT/Soundarajan et al. - 2014 - A Guide to Selecting a Network Similarity Method.pdf}
}

