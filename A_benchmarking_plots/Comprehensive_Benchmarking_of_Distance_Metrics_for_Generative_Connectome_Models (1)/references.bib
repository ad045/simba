@incollection{fornito_2016_chapter,
  title = {Chapter 1 - {{An Introduction}} to {{Brain Networks}}},
  booktitle = {Fundamentals of {{Brain Network Analysis}}},
  editor = {Fornito, Alex and Zalesky, Andrew and Bullmore, Edward T.},
  year = 2016,
  month = jan,
  pages = {1--35},
  publisher = {Academic Press},
  address = {San Diego},
  doi = {10.1016/B978-0-12-407908-3.00001-7},
  urldate = {2025-06-04},
  abstract = {In this chapter, we introduce the science of connectomics and focus in particular on the use of graphs to analyze the topology of nervous systems, from macro to micro scales. The basic principles of graphs are described. We illustrate the historical development of network concepts in neuroscience, from 19th century pioneers to the first quantitative analyses of small-worldness, hubs, modules and other complex topological properties in the C. elegans neuronal wiring diagram, mammalian tract tracing data, and in human neuroimaging. We highlight areas of future growth in the field, including early work in linking human brain macroscale network topology to cognitive function and clinical disorders. We also introduce work that looks at the molecular and cellular substrates for brain graph topology. We demonstrate that graphs are a relatively simple, accessible, and generalizable way of modeling brain network organization across a wide range of scales of space and time, experimental modalities, and species.},
  isbn = {978-0-12-407908-3},
  keywords = {Axon,Brain,Brain imaging,Connectivity,Connectome,Cortex,Graph theory,Modularity,MRI,Neuroscience,Rich club,Scale free,Small world}
}

@incollection{fornito_2016_chaptera,
  title = {Chapter 2 - {{Nodes}} and {{Edges}}},
  booktitle = {Fundamentals of {{Brain Network Analysis}}},
  editor = {Fornito, Alex and Zalesky, Andrew and Bullmore, Edward T.},
  year = 2016,
  month = jan,
  pages = {37--88},
  publisher = {Academic Press},
  address = {San Diego},
  doi = {10.1016/B978-0-12-407908-3.00002-9},
  urldate = {2025-06-04},
  abstract = {Nodes and edges are the elemental building blocks of networks, and their accurate definition is of paramount importance for any valid graphical theoretical model of network organization. A particular challenge for neuroscience is the multiscale organization of the brain, which means that networks can be validly defined at the microscale level of cells and synapses, the mesoscale level of cell populations and axons, and the macroscale level of brain regions and fiber tracts. In this chapter, we provide an overview of different methods for mapping brain connectivity, and defining nodes and edges at each scale, while highlighting the strengths and advantages of each approach. We explain differences between the three major classes of brain connectivity -- structural, functional, and effective -- and consider the limitations associated with their measurement at each resolution scale.},
  isbn = {978-0-12-407908-3},
  keywords = {Connectomics,Electron microscopy,Macroscopic,Mesoscopic,Microscopic,Nodes and edges,Tractography}
}

@incollection{fornito_2016_chapterb,
  title = {Chapter 3 - {{Connectivity Matrices}} and {{Brain Graphs}}},
  booktitle = {Fundamentals of {{Brain Network Analysis}}},
  editor = {Fornito, Alex and Zalesky, Andrew and Bullmore, Edward T.},
  year = 2016,
  month = jan,
  pages = {89--113},
  publisher = {Academic Press},
  address = {San Diego},
  doi = {10.1016/B978-0-12-407908-3.00003-0},
  urldate = {2025-06-04},
  abstract = {Connectomes can be represented equivalently in either matrix or graph form. These representations form the basis for all subsequent analyses of network organization. In this chapter, we overview the major types of matrices and graphs studied in connectomics, namely, those describing binary and weighted networks as well as directed and undirected networks. We consider basic properties of networks, such as connection density and weight, and review different methods for visualizing a network, either by reordering the rows and columns of the connectivity matrix, or by projecting network graphs into anatomical or topological space. We then discuss, in detail, the properties of an ideal graph-based model of a connectome, and the extent to which this ideal has been realized with current approaches.},
  isbn = {978-0-12-407908-3},
  keywords = {Adjacency,Connectogram,Connectome,Digraph,Edge,Force-directed,Graph,Matrix,Node}
}

@incollection{fornito_2016_chapterc,
  title = {Chapter 4 - {{Node Degree}} and {{Strength}}},
  booktitle = {Fundamentals of {{Brain Network Analysis}}},
  editor = {Fornito, Alex and Zalesky, Andrew and Bullmore, Edward T.},
  year = 2016,
  month = jan,
  pages = {115--136},
  publisher = {Academic Press},
  address = {San Diego},
  doi = {10.1016/B978-0-12-407908-3.00004-2},
  urldate = {2025-06-04},
  abstract = {A basic property of a network node is its degree, or the number of connections it has with other nodes. Degree is not distributed homogeneously across the nodes of brain networks; instead, some nodes have a very high degree, marking them as putative network hubs. Characterizing the distribution of degree across nodes is, therefore, an important component of any network analysis. In this chapter, we define node degree for directed and undirected networks, and consider its weighted analogue, node strength. We discuss different types of network degree distribution, focusing on the distinction between single-scale, scale-free (i.e., power-law), and broad-scale networks, and examine appropriate methods for their characterization. We also consider studies examining the distribution of connectivity weights in brain networks, focusing in particular on evidence that these weights have a lognormal distribution.},
  isbn = {978-0-12-407908-3},
  keywords = {Adjacency,Connectivity,Degree,Distribution,Hub,Lognormal,Power law,Scale free,Strength}
}

@incollection{fornito_2016_chapterd,
  title = {Chapter 5 - {{Centrality}} and {{Hubs}}},
  booktitle = {Fundamentals of {{Brain Network Analysis}}},
  editor = {Fornito, Alex and Zalesky, Andrew and Bullmore, Edward T.},
  year = 2016,
  month = jan,
  pages = {137--161},
  publisher = {Academic Press},
  address = {San Diego},
  doi = {10.1016/B978-0-12-407908-3.00005-4},
  urldate = {2025-06-04},
  abstract = {A natural question to ask in a network analysis is whether some nodes are more important for network function than others. This question is intimately related to the concept of topological centrality: the capacity of a node to influence, or be influenced by, other nodes by virtue of its connectivity. In this chapter, we consider three broad classes of centrality measures: those based on degree, including eigenvector and PageRank centrality; those based on closeness, which are related to the average shortest path length of a node; and those based on betweenness. We show how these distinct classes of measures assume different models of information flow on the network, and consider which measures are the most appropriate for brain networks. We also examine how these measures can be used to define network hubs.},
  isbn = {978-0-12-407908-3},
  keywords = {Betweenness,Centrality,Closeness,Degree,Hub,PageRank}
}

@incollection{fornito_2016_chaptere,
  title = {Chapter 6 - {{Components}}, {{Cores}}, and {{Clubs}}},
  booktitle = {Fundamentals of {{Brain Network Analysis}}},
  editor = {Fornito, Alex and Zalesky, Andrew and Bullmore, Edward T.},
  year = 2016,
  month = jan,
  pages = {163--206},
  publisher = {Academic Press},
  address = {San Diego},
  doi = {10.1016/B978-0-12-407908-3.00006-6},
  urldate = {2025-06-04},
  abstract = {In many networks, nodes can aggregate into subsets that play an influential role in network function. This chapter considers different methods for defining these subsets. We start with the coarsest level, in which the analysis of connected components can be used to determine whether or not a network is fragmented, and to understand its robustness to random failure or targeted attack through the lens of percolation theory. We consider methods for decomposing a network into a strongly connected core of topologically central nodes and a sparsely connected periphery. These approaches include those based on block model optimization, core decomposition, and the identification of so-called knotty centres using a measure of betweenness centrality. We then turn to the analysis of rich-club organization, which examines whether the highest degree nodes of the network are more strongly or densely connected with each other than expected by chance. A considerable body of evidence indicates that rich-club organization is a robust feature of brain networks, and plays a vital role in the integration of segregated network elements.},
  isbn = {978-0-12-407908-3},
  keywords = {Assortativity,Block model,Clique,Component,Core-periphery,Fragmentation,Minimum spanning tree,Percolation,Rich-club,Robustness}
}

@incollection{fornito_2016_chapterf,
  title = {Chapter 7 - {{Paths}}, {{Diffusion}}, and {{Navigation}}},
  booktitle = {Fundamentals of {{Brain Network Analysis}}},
  editor = {Fornito, Alex and Zalesky, Andrew and Bullmore, Edward T.},
  year = 2016,
  month = jan,
  pages = {207--255},
  publisher = {Academic Press},
  address = {San Diego},
  doi = {10.1016/B978-0-12-407908-3.00007-8},
  urldate = {2025-06-04},
  abstract = {A key question for connectomics is how topological properties of brain graphs relate to the signaling and information processing functions of nervous systems. Three models of neural information flow are considered in the chapter: shortest path routing, diffusion, and navigation. These models are explained with intuitive metaphors. The efficiency with which information can be communicated under these models is quantified with various measures of network integration. Shortest path routing is the most commonly studied model, and is fundamental to the concept of the brain as a small-world network. Shortest path routing assumes that neurons communicate with well-defined destinations in mind, and that the shortest path to these destinations is known globally. These may be unrealistic assumptions in nervous systems, motivating the study of alternative models of neural information flow that does not mandate centralized, homunculus-like control. Diffusion processes imply that the flow of information is much like the flow of fluids in a network of pipes, which propagates simultaneously along multiple `fronts', without being directed toward a single destination. Communicability is the simplest measure quantifying the efficiency with which information can be communicated under this model. Another model is navigation, where each node forwards information to its closest neighbour in physical distance to the desired destination. Navigation performs particularly well in spatially-embedded, scale-free networks like the brain. We discuss the pros and cons of all three models of neural information flow, and show how they have been applied in order to understand the organization of connectomes at various scales. This chapter also introduces readers to a random walker, the Laplacian matrix and the concept of a network morphospace.},
  isbn = {978-0-12-407908-3},
  keywords = {Characteristic path length,Communicability,Communication,Cycle,Diffusion,Efficiency,Geodesic,Hop count,Laplacian matrix,Mean first passage time,Navigation,Network morphospace,Path,Path transitivity,Random walker,Routing,Search information,Shortest path,Trail,Walk}
}

@incollection{fornito_2016_chapterg,
  title = {Chapter 8 - {{Motifs}}, {{Small Worlds}}, and {{Network Economy}}},
  booktitle = {Fundamentals of {{Brain Network Analysis}}},
  editor = {Fornito, Alex and Zalesky, Andrew and Bullmore, Edward T.},
  year = 2016,
  month = jan,
  pages = {257--301},
  publisher = {Academic Press},
  address = {San Diego},
  doi = {10.1016/B978-0-12-407908-3.00008-X},
  urldate = {2025-06-04},
  abstract = {Motifs are subgraphs of a network that act as elemental building blocks for its topology. Motifs can be defined at the level of connected subgraphs of nodes, or at the level of an ordered sequence of edges comprising a path. Another popular measure for studying small subsets of nodes is the clustering coefficient, which counts the fraction of a node's neighbors, which are also connected to each other. We consider how clustering relates to more general measures of structural equivalence, topological overlap, degeneracy and redundancy in networks, and how it is an essential component of the brain's small-world organization. Small-world properties are thought to endow brain networks with many functional advantages, such as the simultaneous capacity for integrated and segregated function, which gives rise to high dynamical complexity. We close the chapter by examining the important role of wiring costs in driving network organization. Each connection in a brain network carries a cost in terms of the physical space, cellular material, and metabolic resources that it requires. Lying at the heart of the network economy is the effective management of finite metabolic and cellular resources, while supporting the adaptive topological properties that promote robust and adaptive performance. We consider simple methods for capturing the trade-off between cost and adaptive topology, before examining more sophisticated approaches adapted from other scientific disciplines, such as the analysis of Rentian scaling.},
  isbn = {978-0-12-407908-3},
  keywords = {Brain metabolism,Clustering,Complexity,Cost-efficiency,Degeneracy,Fractal,Motif,Mutual information,Network economy,Redundancy,Rentian scaling,Small world,Structural equivalence,Wiring cost}
}

@incollection{fornito_2016_chapterh,
  title = {Chapter 9 - {{Modularity}}},
  booktitle = {Fundamentals of {{Brain Network Analysis}}},
  editor = {Fornito, Alex and Zalesky, Andrew and Bullmore, Edward T.},
  year = 2016,
  month = jan,
  pages = {303--354},
  publisher = {Academic Press},
  address = {San Diego},
  doi = {10.1016/B978-0-12-407908-3.00009-1},
  urldate = {2025-06-04},
  abstract = {The nodes of many real-world networks are often more strongly connected with some sets of nodes than with others, giving rise to densely linked communities of nodes called modules. These modules also contain submodules across several scales of topological resolution, resulting in a hierarchical modular organization. This chapter presents key methods for characterizing the modular structure of brain networks. We begin by discussing traditional hierarchical clustering approaches, before explaining methods based on betweenness centrality and the optimization of a quality function called the modularity index. We consider methods for characterizing the modular organization of populations of networks, for quantifying the overlap between two modular partitions, and for constructing a consensus partition from multiple decompositions. Statistical methods for comparing the modular structure of two or more networks are also considered. We overview the limitations of modularity maximization, consider alternatives, and introduce methods for studying overlapping modules. The chapter closes with a discussion on how dynamic modular structure can be studied in temporally evolving systems through the use of multilayer network models.},
  isbn = {978-0-12-407908-3},
  keywords = {Community structure,Dendrogram,Hierarchical clustering,Louvain algorithm,modularity,multilayer network,participation coefficient,partition overlap}
}

@incollection{fornito_2016_chapteri,
  title = {Chapter 10 - {{Null Models}}},
  booktitle = {Fundamentals of {{Brain Network Analysis}}},
  editor = {Fornito, Alex and Zalesky, Andrew and Bullmore, Edward T.},
  year = 2016,
  month = jan,
  pages = {355--381},
  publisher = {Academic Press},
  address = {San Diego},
  doi = {10.1016/B978-0-12-407908-3.00010-8},
  urldate = {2025-06-04},
  abstract = {Null models are crucial in determining whether brain networks display certain features to a greater extent than expected by chance under a null hypothesis. The most common null model for a graph is constructed by rewiring its edges according to the Maslov-Sneppen rewiring algorithm. Rather than randomizing an existing network, null models can also be constructed by growing networks according to a generative mechanism. The classic Watts-Strogatz model generates small-world networks, while the Barab\'asi-Albert model is based on a preferential attachment mechanism that produces scale-free degree distributions. Generative models that take into account the spatial embedding of a nervous system can accurately predict many spatial and topological features. One of the most accurate and simplest of these models is the so-called economical clustering model, which places a penalty on long distance connections, and encourages the formation of closed triangle motifs. Null models for correlation-based functional networks present particular challenges. Techniques for generating null models that preserve the intrinsic transitivity of these networks are described. This chapter also considers exponential random graph models, which are a versatile approach for sampling networks from a specified distribution, as well as generalizations of the Maslov-Sneppen rewiring algorithm that can be applied to weighted and signed graphs. Null models for testing hypotheses about functional connectivity dynamics are briefly covered.},
  isbn = {978-0-12-407908-3},
  keywords = {Generative model,Nonstationarity,Null model,Preferential attachment,Random graph,Small-world,Time series}
}

@incollection{fornito_2016_chapterj,
  title = {Chapter 11 - {{Statistical Connectomics}}},
  booktitle = {Fundamentals of {{Brain Network Analysis}}},
  editor = {Fornito, Alex and Zalesky, Andrew and Bullmore, Edward T.},
  year = 2016,
  month = jan,
  pages = {383--419},
  publisher = {Academic Press},
  address = {San Diego},
  doi = {10.1016/B978-0-12-407908-3.00011-X},
  urldate = {2025-06-04},
  abstract = {This chapter considers two important topics in the statistical analysis of brain networks: thresholding and statistical hypothesis testing. Brain connectivity data are noisy, meaning that brain networks contain false positives (spurious connections) and false negatives (the absence of real connections). Applying a threshold to the adjacency matrix can suppress the contribution of spurious connections, and allows for the fixing of the connection density of the network. When analyzing groups of brain networks, thresholding can be performed to ensure a common connection density across all individuals, or with respect to an absolute edge weight threshold, it can eliminate all connections with weights less than the specified threshold. The pros and cons of these two global thresholding strategies are considered in detail. Local thresholding methods based on the minimum spanning tree, and the disparity filter, are also described. Unlike global thresholding, local methods can avoid network fragmentation. The second part of this chapter focuses on statistical hypothesis testing on the connectome. We consider statistical inference at the level of the connectome as a whole (global testing) as well as connectome-wide testing of a null hypothesis at every node and/or connection (mass univariate testing). While the latter approach enables finer localization of statistical effects, it presents a daunting multiple comparisons problem. Old and trusted generic methods as well as novel network-specific methods for dealing with the multiple comparisons problem are presented, including the false discovery rate, network-based statistic, and cutting-edge multivariate approaches. The appeal of multivariate approaches is that they allow inference at the level of individuals. This chapter also discusses how clinical differences in brain networks can be interpreted with respect to pathophysiological mechanisms. A non-technical introduction to permutation tests is provided.},
  isbn = {978-0-12-407908-3},
  keywords = {False discovery rate,Machine learning,Multiple comparisons,Multivariate,Network-based statistic,Statistical inference,Support vector machine},
  file = {/Users/adrian/Zotero/storage/K6XS9KRE/Fornito et al. - 2016 - Chapter 11 - Statistical Connectomics.pdf}
}

