  langid = {english},
  keywords = {Computational neuroscience,Epilepsy,Translational research},
  file = {/Users/adrian/Zotero/storage/WD9L5AHU/Wang et al. - 2025 - Virtual brain twins for stimulation in epilepsy.pdf}
}

@article{warrington_2022_concurrent,
  title = {Concurrent Mapping of Brain Ontogeny and Phylogeny within a Common Space: {{Standardized}} Tractography and Applications},
