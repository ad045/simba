@article{lin_2023_frequency_,
  title = {A {{Frequency Estimation Scheme Based}} on {{Gaussian Average Filtering Decomposition}} and {{Hilbert Transform}}: {{With Estimation}} of {{Respiratory Rate}} as an {{Example}}},
  shorttitle = {A {{Frequency Estimation Scheme Based}} on {{Gaussian Average Filtering Decomposition}} and {{Hilbert Transform}}},
