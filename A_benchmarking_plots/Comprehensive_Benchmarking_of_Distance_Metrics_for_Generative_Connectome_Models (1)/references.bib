}

@incollection{carlsonChapterSkin2019,
  title = {Chapter 3 - {{Skin}}},
  booktitle = {The {{Human Body}}},
  author = {Carlson, Bruce M.},
  editor = {Carlson, Bruce M.},
  year = 2019,
  month = jan,
  pages = {65--85},
  publisher = {Academic Press},
  doi = {10.1016/B978-0-12-804254-0.00003-X},
  urldate = {2022-12-08},
  abstract = {The skin consists of three regions---the epidermis, the dermis, and the hypodermis. The skin is richly supplied with a variety of sensory nerve endings that monitor the external environment. Thermoregulation of the body is accomplished largely through sweating and changes in blood flow within the skin. Protection from ultraviolet radiation depends upon the amount of pigmentation within epidermal cells. The skin acts as a barrier in a number of respects. Hairs and nails are complex epidermal appendages that have their own growth cycles. The character of both hairs and nails varies in different parts of the body. The skin possesses an abundant microbiome, with huge numbers of many species of microorganisms. When the integrity of the skin is disrupted a robust wound healing response restores the integrity of the skin. Both photoaging and chronological aging change the character of the skin.},
  isbn = {978-0-12-804254-0},
  langid = {english},
  keywords = {aging,barrier functions,dermis,emotional responses,epidermis,hair,hypodermis,nails,pigmentation,sensory nerve endings,Skin,skin microbiome,thermal regulation,wound healing},
  file = {/Users/adrian/Zotero/storage/TEH39SBA/B978012804254000003X.html}
}

