@article{khambhati_2017_recurring,
  title = {Recurring {{Functional Interactions Predict Network Architecture}} of {{Interictal}} and {{Ictal States}} in {{Neocortical Epilepsy}}},
  author = {Khambhati, Ankit N. and Bassett, Danielle S. and Oommen, Brian S. and Chen, Stephanie H. and Lucas, Timothy H. and Davis, Kathryn A. and Litt, Brian},
  year = 2017,
  journal = {eNeuro},
  volume = {4},
